---
import { localizedPath } from '~/i18n/utils';
import type { Lang } from '~/i18n/utils';
import { v3Copy, type V3Lang } from './copy';

export interface Props {
  lang: Lang;
  downloadUrl: string;
}

const { lang, downloadUrl } = Astro.props;
const key = (lang === 'zh-cn' ? 'zh-cn' : 'en') as V3Lang;
const c = v3Copy[key];
const l = (path: string) => localizedPath(lang, path);

const isZh = key === 'zh-cn';
const currentLabel = isZh ? '中文' : 'EN';
const otherLabel = isZh ? 'EN' : '中文';
const otherHref = isZh ? localizedPath('en', '/') : localizedPath('zh-cn', '/');
---

<header class="v3-header">
  <div class="v3-wrap v3-nav">
    <a class="v3-logo" href={l('/')} aria-label="Shotera">
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <defs>
          <linearGradient id="v3-mark" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#4a9eff"></stop>
            <stop offset="1" stop-color="#0d44e8"></stop>
          </linearGradient>
        </defs>
        <rect width="26" height="26" rx="7" fill="url(#v3-mark)"></rect>
        <path
          d="M8.4 10.6V9.4a1 1 0 0 1 1-1h1.2M16.4 8.4h1.2a1 1 0 0 1 1 1v1.2M18.6 15.4v1.2a1 1 0 0 1-1 1h-1.2M9.6 17.6H8.4a1 1 0 0 1-1-1v-1.2"
          stroke="#fff"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <circle cx="13" cy="13" r="1.7" fill="#fff"></circle>
      </svg>
      Shotera
    </a>

    <a class="v3-navlink" href={l('/#features')}>{c.nav.features}</a>
    <a class="v3-navlink" href={l('/versions')}>{c.nav.versions}</a>
    <a class="v3-navlink" href={l('/changelog')}>{c.nav.changelog}</a>
    <a class="v3-navlink" href={l('/faq')}>{c.nav.faq}</a>
    <a class="v3-navlink" href={l('/about')}>{c.nav.about}</a>

    <div class="v3-nav-right">
      <span class="v3-lang">
        <b>{currentLabel}</b><span aria-hidden="true">/</span><a href={otherHref}>{otherLabel}</a>
      </span>
      <a
        class="v3-ghost-icon"
        href="https://github.com/mosuzo-studio/Shotera"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
      >
        <svg width="22" height="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A7.995 7.995 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <a class="v3-pill-dark" href={downloadUrl}>{c.nav.cta}</a>

      <button
        class="v3-burger"
        type="button"
        aria-label={c.nav.menu}
        aria-expanded="false"
        aria-controls="v3-mobile-menu"
        data-v3-burger
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="v3-mobile-menu" id="v3-mobile-menu" hidden data-v3-menu>
    <a href={l('/#features')}>{c.nav.features}</a>
    <a href={l('/versions')}>{c.nav.versions}</a>
    <a href={l('/changelog')}>{c.nav.changelog}</a>
    <a href={l('/faq')}>{c.nav.faq}</a>
    <a href={l('/about')}>{c.nav.about}</a>
  </div>
</header>

<script>
  function initV3MobileMenu() {
    const button = document.querySelector<HTMLButtonElement>('[data-v3-burger]');
    const menu = document.querySelector<HTMLElement>('[data-v3-menu]');
    if (!button || !menu || button.dataset.wired === '1') return;
    button.dataset.wired = '1';

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    };

    button.addEventListener('click', () => setOpen(menu.hidden));
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });

    document.addEventListener('click', (event) => {
      if (menu.hidden || !(event.target instanceof Node)) return;
      if (button.contains(event.target) || menu.contains(event.target)) return;
      setOpen(false);
    });
  }

  initV3MobileMenu();
  document.addEventListener('astro:page-load', initV3MobileMenu);
</script>
