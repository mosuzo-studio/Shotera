---
import { localizedPagePath } from '~/i18n/utils';
import type { Lang } from '~/i18n/utils';
import { studioContactUrl, studioHome, studioProductsUrl } from '~/data/studio';
import { getV3Copy } from './copy-intl';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = getV3Copy(lang);
const refreshed = lang === 'en' || lang === 'zh-cn';
const zh = lang === 'zh-cn';
const l = (path: string, hash?: string) => `${localizedPagePath(lang, path)}${hash ? `#${hash}` : ''}`;
---

<footer class="v3-footer">
  <div class="v3-wrap">
    <div class="v3-footer-cols">
      <div>
        <h4>Shotera</h4>
        <p class="v3-foot-note" style="margin:0;max-width:280px">{c.footer.blurb}</p>
      </div>
      {
        c.footer.cols.map((col, index) => (
          <div>
            <h4>
              {refreshed && index === c.footer.cols.length - 1
                ? zh
                  ? '工作室'
                  : 'Studio'
                : col.title}
            </h4>
            {col.links.map((link) => (
              <a href={l(link.path, link.hash)}>{link.text}</a>
            ))}
            {refreshed && index === c.footer.cols.length - 1 && (
              <>
                <a href={studioHome(lang)}>{zh ? '工作室首页' : 'Studio home'}</a>
                <a href={studioProductsUrl(lang)}>{zh ? '全部产品' : 'All products'}</a>
                <a href={studioContactUrl(lang)}>{zh ? '联系工作室' : 'Contact the studio'}</a>
              </>
            )}
          </div>
        ))
      }
    </div>

    <div class="v3-footer-base">
      <span dir="ltr">{c.footer.rights}</span>
      {c.footer.legal.map((link) => <a href={l(link.path)}>{link.text}</a>)}
      <span class="v3-sp">{c.footer.system}</span>
    </div>
  </div>
</footer>
