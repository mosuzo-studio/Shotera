---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import AboutBannerRandom from '~/components/common/AboutBannerRandom.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import PageLayoutV3 from '~/layouts/PageLayoutV3.astro';
import { getSetupDownloadUrl } from '~/utils/download';
import { localeExtras } from '~/i18n/locale-extras';
import type { LocalizedSiteContent, LocalizedLocale } from '~/i18n/site-content';

interface Props {
  locale: LocalizedLocale;
  content: LocalizedSiteContent;
}

const { locale, content } = Astro.props;
const extra = localeExtras[locale];
const setupUrl = await getSetupDownloadUrl();

// Same structure as the English about page: the capability grid is split into
// L1 core capabilities (six text cards) and L2 more capabilities (nine cards
// beside the illustration); icons follow the card order, not the copy.
const standIcons = ['tabler:bolt', 'tabler:lock', 'tabler:sparkles'];
const coreIcons = [
  'tabler:capture',
  'local:longshot',
  'tabler:pin',
  'tabler:video',
  'tabler:text-recognition',
  'tabler:wand',
];
const moreIcons = [
  'tabler:pencil',
  'tabler:mood-smile',
  'tabler:photo',
  'tabler:language',
  'tabler:qrcode',
  'tabler:crop',
  'tabler:devices',
  'tabler:moon',
  'tabler:presentation',
];
const historyIcons = ['tabler:seeding', 'tabler:users', 'tabler:world'];
const contactIcons = ['tabler:brand-discord', 'tabler:mail'];

const metadata = {
  title: content.pages.about[0],
  description: extra.about.metaDescription,
};
---

<PageLayoutV3 metadata={metadata} lang={locale}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline={extra.about.hero.tagline}
    image={{
      src: '~/assets/images/about-hero.png',
      alt: extra.about.hero.alt,
    }}
  >
    <Fragment slot="title">
      {extra.about.hero.title} <br />
      <span class="text-accent dark:text-white">{extra.about.hero.accent}</span>
    </Fragment>

    <Fragment slot="subtitle">{extra.about.hero.subtitle}</Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats title={extra.about.statsTitle} stats={extra.about.stats} />

  <!-- Features3 Widget ************** -->

  <Features3
    title={extra.about.stand.title}
    subtitle={extra.about.stand.subtitle}
    columns={3}
    isBeforeContent={true}
    items={extra.about.stand.items.map((item, index) => ({ ...item, icon: standIcons[index] }))}
  />

  <!-- Features3 Widget: L1 core capabilities ************** -->

  <Features3
    title={extra.about.core.title}
    subtitle={extra.about.core.subtitle}
    columns={3}
    isAfterContent={true}
    items={extra.about.core.items.map((item, index) => ({ ...item, icon: coreIcons[index] }))}
    image={{
      src: '~/assets/images/about-cat-1.webp',
      alt: extra.about.core.alt,
    }}
  />

  <AboutBannerRandom />

  <!-- Features3 Widget: L2 more capabilities ************** -->

  <Features3
    title={extra.about.more.title}
    subtitle={extra.about.more.subtitle}
    columns={3}
    items={extra.about.more.items.map((item, index) => ({ ...item, icon: moreIcons[index] }))}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2 title={extra.about.values.title} subtitle={extra.about.values.subtitle} items={extra.about.values.items} />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title={extra.about.history.title}
    subtitle={extra.about.history.subtitle}
    isReversed={true}
    callToAction={{
      text: extra.about.history.cta,
      href: setupUrl,
    }}
    items={extra.about.history.items.map((item, index) => ({ ...item, icon: historyIcons[index] }))}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title={extra.about.contact.title}
    tagline={extra.about.contact.tagline}
    columns={2}
    items={extra.about.contact.items.map((item, index) => ({ ...item, icon: contactIcons[index] }))}
  />
</PageLayoutV3>
