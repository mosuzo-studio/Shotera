---
import { Image } from 'astro:assets';

import PageLayout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps from '~/components/widgets/Steps.astro';
import DownloadButtons from '~/components/ui/DownloadButtons.astro';
import { homeFeaturesContent } from '~/i18n/home-features';
import { downloadMenuContent } from '~/i18n/download-menu-content';
import { localeExtras } from '~/i18n/locale-extras';
import type { LocalizedSiteContent, LocalizedLocale } from '~/i18n/site-content';

import heroImage from '~/assets/images/hero-image.png';
import workflowImage from '~/assets/images/workflow.png';

interface Props {
  locale: LocalizedLocale;
  content: LocalizedSiteContent;
}

const { locale, content } = Astro.props;
const features = homeFeaturesContent[locale];
const downloadMenu = downloadMenuContent[locale];
const extra = localeExtras[locale];

// The grid mirrors the English homepage: the locale's own seven cards, with
// the scrolling-capture, QR/barcode and image-viewer cards slotted into the
// same positions the English grid uses.
const gridItems = [
  features.features.items[0],
  extra.home.cards[0],
  features.features.items[1],
  features.features.items[2],
  features.features.items[3],
  features.features.items[4],
  extra.home.cards[1],
  features.features.items[5],
  features.features.items[6],
  extra.home.cards[2],
];
const gridIcons = [
  'tabler:capture',
  'local:longshot',
  'tabler:video',
  'tabler:scissors',
  'tabler:eraser',
  'tabler:text-recognition',
  'tabler:qrcode',
  'tabler:language',
  'tabler:pin',
  'tabler:photo',
];
const moreFeatureIcons = [
  'tabler:mood-happy',
  'tabler:zoom-in',
  'tabler:list-numbers',
  'tabler:pin',
  'tabler:keyboard',
  'tabler:history',
  'tabler:devices',
  'tabler:lock',
  'tabler:bolt',
  'tabler:moon',
];
const stepIcons = ['tabler:keyboard', 'tabler:wand', 'tabler:share'];
const doneLabels: Record<LocalizedLocale, string> = {
  'zh-tw': '完成！',
  ja: '完了！',
  ko: '완료!',
  'pt-br': 'Pronto!',
  es: '¡Listo!',
  de: 'Fertig!',
  fr: 'Terminé !',
  it: 'Fatto!',
  nl: 'Klaar!',
  pl: 'Gotowe!',
  ru: 'Готово!',
  sv: 'Klart!',
  ar: 'تم!',
};

const metadata = {
  title: content.metaTitle,
  description: content.metaDescription,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata} lang={locale}>
  <script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

  <section class="relative px-5 pb-20 pt-20 sm:pt-28">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(37,99,235,0.14),transparent_50%)]"></div>
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-blue-600">Shotera for Windows</p>
      <h1 class="text-balance text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
        {content.heroTitle}
        <span class="text-blue-600 dark:text-blue-400">{content.heroAccent}</span>
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-pretty text-lg leading-8 text-gray-600 dark:text-gray-300">
        {content.heroSubtitle}
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-sm font-medium text-gray-500 dark:text-gray-400">{content.philosophy}</p>
      <div class="relative z-10 mt-10 flex justify-center">
        <DownloadButtons
          language={content.storeLanguage}
          downloadLabel={content.labels.freeDownload}
          moreVersionsLabel={content.moreVersions}
          storeAriaLabel={content.storeAria}
          downloadAriaLabel={content.labels.freeDownload}
          moreVersionsAriaLabel={content.moreVersions}
          msiLabel={downloadMenu.msi}
          portableLabel={downloadMenu.portable}
          allVersionsLabel={downloadMenu.allVersions}
          setupLabel={downloadMenu.setup}
          recommendLabel={downloadMenu.recommended}
          footnoteLabel={downloadMenu.footnote}
          footnoteHref={`/${locale}/versions/`}
        />
      </div>
    </div>

    <div class="mx-auto mt-14 max-w-5xl">
      <Image
        src={heroImage}
        alt={extra.home.heroAlt}
        widths={[600, 1000, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        class="w-full rounded-2xl"
        loading="eager"
      />
    </div>
  </section>

  <Features
    id="features"
    tagline={features.features.tagline}
    title={features.features.title}
    subtitle={features.features.subtitle}
    items={gridItems.map((item, index) => ({ ...item, icon: gridIcons[index] }))}
  />

  <Content
    isReversed
    tagline={features.capture.tagline}
    title={features.capture.title}
    items={features.capture.items}
    image={{ src: '~/assets/images/capture-demo.png', alt: features.capture.title }}
  >
    <Fragment slot="content">
      <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">{features.capture.heading}</h3>
      {features.capture.text}
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline={extra.home.scrolling.tagline}
    title={extra.home.scrolling.title}
    items={extra.home.scrolling.items}
    image={{ src: '~/assets/images/longshot-demo.png', alt: extra.home.scrolling.alt }}
  >
    <Fragment slot="content">{extra.home.scrolling.text}</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    tagline={features.recording.tagline}
    title={features.recording.title}
    items={features.recording.items}
    image={{ src: '~/assets/images/recording-demo.png', alt: features.recording.title }}
  >
    <Fragment slot="content">{features.recording.text}</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline={features.ai.tagline}
    title={features.ai.title}
    items={features.ai.items}
    image={{ src: '~/assets/images/ai-demo.png', alt: features.ai.title }}
  >
    <Fragment slot="content">{features.ai.text}</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Steps
    title={extra.home.workflow.title}
    items={[
      ...extra.home.workflow.steps.map((step, index) => ({ ...step, icon: stepIcons[index] })),
      { title: doneLabels[locale], icon: 'tabler:check' },
    ]}
    image={{ src: '~/assets/images/workflow.png', alt: extra.home.workflow.alt }}
  />

  <Features2
    title={features.more.title}
    subtitle={features.more.subtitle}
    tagline={features.more.tagline}
    items={features.more.items.map((item, index) => ({ ...item, icon: moreFeatureIcons[index] }))}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <Stats stats={extra.home.stats} />

  <section class="px-5 pb-24">
    <div class="mx-auto max-w-5xl rounded-3xl bg-gray-950 px-6 py-14 text-center text-white sm:px-12">
      <h2 class="text-3xl font-bold sm:text-4xl">{content.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-300">{content.ctaText}</p>
      <div class="mt-8 flex justify-center">
        <DownloadButtons
          language={content.storeLanguage}
          downloadLabel={content.labels.freeDownload}
          moreVersionsLabel={content.moreVersions}
          storeAriaLabel={content.storeAria}
          downloadAriaLabel={content.labels.freeDownload}
          moreVersionsAriaLabel={content.moreVersions}
          msiLabel={downloadMenu.msi}
          portableLabel={downloadMenu.portable}
          allVersionsLabel={downloadMenu.allVersions}
          setupLabel={downloadMenu.setup}
          recommendLabel={downloadMenu.recommended}
          footnoteLabel={downloadMenu.footnote}
          footnoteHref={`/${locale}/versions/`}
        />
      </div>
    </div>
  </section>
</PageLayout>
