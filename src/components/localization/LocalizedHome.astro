---
import PageLayout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import DownloadButtons from '~/components/ui/DownloadButtons.astro';
import { homeFeaturesContent } from '~/i18n/home-features';
import { downloadMenuContent } from '~/i18n/download-menu-content';
import type { LocalizedSiteContent, LocalizedLocale } from '~/i18n/site-content';

interface Props {
  locale: LocalizedLocale;
  content: LocalizedSiteContent;
}

const { locale, content } = Astro.props;
const features = homeFeaturesContent[locale];
const downloadMenu = downloadMenuContent[locale];

// Icons mirror the English homepage so localized copy stays icon-free.
const coreFeatureIcons = [
  'tabler:capture',
  'tabler:video',
  'tabler:scissors',
  'tabler:eraser',
  'tabler:text-recognition',
  'tabler:language',
  'tabler:pin',
];
const moreFeatureIcons = [
  'tabler:mood-happy',
  'tabler:zoom-in',
  'tabler:list-numbers',
  'tabler:pin',
  'tabler:keyboard',
  'tabler:history',
  'tabler:devices',
  'tabler:lock',
  'tabler:bolt',
  'tabler:moon',
];

const metadata = {
  title: content.metaTitle,
  description: content.metaDescription,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata} lang={locale}>
  <script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

  <section class="relative px-5 pb-20 pt-20 sm:pt-28">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,rgba(37,99,235,0.14),transparent_50%)]"></div>
    <div class="mx-auto max-w-5xl text-center">
      <p class="mb-5 text-sm font-semibold uppercase tracking-[0.22em] text-blue-600">Shotera for Windows</p>
      <h1 class="text-balance text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl">
        {content.heroTitle}
        <span class="text-blue-600 dark:text-blue-400">{content.heroAccent}</span>
      </h1>
      <p class="mx-auto mt-7 max-w-3xl text-pretty text-lg leading-8 text-gray-600 dark:text-gray-300">
        {content.heroSubtitle}
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-sm font-medium text-gray-500 dark:text-gray-400">{content.philosophy}</p>
      <div class="relative z-10 mt-10 flex justify-center">
        <DownloadButtons
          language={content.storeLanguage}
          downloadLabel={content.labels.freeDownload}
          moreVersionsLabel={content.moreVersions}
          storeAriaLabel={content.storeAria}
          downloadAriaLabel={content.labels.freeDownload}
          moreVersionsAriaLabel={content.moreVersions}
          msiLabel={downloadMenu.msi}
          portableLabel={downloadMenu.portable}
          allVersionsLabel={downloadMenu.allVersions}
          showLite
          setupLabel={downloadMenu.setup}
          standardGroupLabel={downloadMenu.standard}
          liteGroupLabel={downloadMenu.lite}
        />
      </div>
    </div>
  </section>

  <Features
    id="features"
    tagline={features.features.tagline}
    title={features.features.title}
    subtitle={features.features.subtitle}
    items={features.features.items.map((item, index) => ({ ...item, icon: coreFeatureIcons[index] }))}
  />

  <Content
    isReversed
    tagline={features.capture.tagline}
    title={features.capture.title}
    items={features.capture.items}
    image={{ src: '~/assets/images/capture-demo.png', alt: features.capture.title }}
  >
    <Fragment slot="content">
      <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">{features.capture.heading}</h3>
      {features.capture.text}
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isAfterContent
    tagline={features.recording.tagline}
    title={features.recording.title}
    items={features.recording.items}
    image={{ src: '~/assets/images/recording-demo.png', alt: features.recording.title }}
  >
    <Fragment slot="content">{features.recording.text}</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent
    tagline={features.ai.tagline}
    title={features.ai.title}
    items={features.ai.items}
    image={{ src: '~/assets/images/ai-demo.png', alt: features.ai.title }}
  >
    <Fragment slot="content">{features.ai.text}</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <section class="bg-gray-50 px-5 py-20 dark:bg-gray-900/50 sm:py-24">
    <div class="mx-auto max-w-5xl">
      <h2 class="text-center text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        {content.workflowTitle}
      </h2>
      <ol class="mt-12 grid gap-6 md:grid-cols-2">
        {
          content.workflow.map((step, index) => (
            <li class="flex gap-4 rounded-2xl bg-white p-6 shadow-sm dark:bg-gray-900">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-600 font-bold text-white">
                {index + 1}
              </span>
              <span class="pt-1 leading-7 text-gray-700 dark:text-gray-200">{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Features2
    title={features.more.title}
    subtitle={features.more.subtitle}
    tagline={features.more.tagline}
    items={features.more.items.map((item, index) => ({ ...item, icon: moreFeatureIcons[index] }))}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <section class="px-5 pb-24">
    <div class="mx-auto max-w-5xl rounded-3xl bg-gray-950 px-6 py-14 text-center text-white sm:px-12">
      <h2 class="text-3xl font-bold sm:text-4xl">{content.ctaTitle}</h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-300">{content.ctaText}</p>
      <div class="mt-8 flex justify-center">
        <DownloadButtons
          language={content.storeLanguage}
          downloadLabel={content.labels.freeDownload}
          moreVersionsLabel={content.moreVersions}
          storeAriaLabel={content.storeAria}
          downloadAriaLabel={content.labels.freeDownload}
          moreVersionsAriaLabel={content.moreVersions}
          msiLabel={downloadMenu.msi}
          portableLabel={downloadMenu.portable}
          allVersionsLabel={downloadMenu.allVersions}
          showLite
          setupLabel={downloadMenu.setup}
          standardGroupLabel={downloadMenu.standard}
          liteGroupLabel={downloadMenu.lite}
        />
      </div>
    </div>
  </section>
</PageLayout>
