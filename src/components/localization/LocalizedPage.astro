---
import { Icon } from 'astro-icon/components';

import PageLayout from '~/layouts/PageLayout.astro';
import type { LocalizedSiteContent, LocalizedLocale } from '~/i18n/site-content';

interface Props {
  locale: LocalizedLocale;
  path: string;
  content: LocalizedSiteContent;
}

const { locale, path, content } = Astro.props;
const pageKey = path === '404' ? 'notFound' : path;
const page =
  path === 'blog'
    ? [content.labels.blog, content.labels.releaseText]
    : pageKey in content.pages
      ? content.pages[pageKey as keyof typeof content.pages]
      : (content.scenarios[path] ?? [content.featuresTitle, content.featuresSubtitle]);
const [title, intro] = page;
const isPricing = path === 'pricing';
const isContact = path === 'contact';
const isChangelog = path === 'changelog';
const isAboutOrServices = path === 'about' || path === 'services';
const metadata = { title, description: intro };
---

<PageLayout metadata={metadata} lang={locale}>
  <section class="px-5 pb-16 pt-20 sm:pb-20 sm:pt-28">
    <div class="mx-auto max-w-4xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-600">Shotera</p>
      <h1 class="mt-5 text-balance text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
        {title}
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-pretty text-lg leading-8 text-gray-600 dark:text-gray-300">{intro}</p>
    </div>
  </section>

  <section class="px-5 pb-24">
    <div class="mx-auto max-w-5xl">
      {
        isPricing ? (
          <div class="grid gap-6 md:grid-cols-2">
            <article class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{content.labels.free}</h2>
              <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">{content.labels.freeText}</p>
            </article>
            <article class="rounded-3xl border border-blue-300 bg-blue-50 p-8 dark:border-blue-800 dark:bg-blue-950/30">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{content.labels.pro}</h2>
              <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">{content.labels.proText}</p>
            </article>
          </div>
        ) : isContact ? (
          <div class="rounded-3xl border border-gray-200 p-8 text-center dark:border-gray-800 sm:p-12">
            <p class="text-lg leading-8 text-gray-600 dark:text-gray-300">{content.labels.contactText}</p>
            <div class="mt-8 flex flex-wrap justify-center gap-4">
              <a
                class="rounded-xl bg-gray-950 px-6 py-3 font-semibold text-white dark:bg-white dark:text-gray-950"
                href="https://github.com/mosuzo-studio/Shotera/issues"
              >
                GitHub Issues
              </a>
              <a
                class="rounded-xl border border-gray-300 px-6 py-3 font-semibold dark:border-gray-700"
                href="mailto:mosuzo.studio@gmail.com"
              >
                mosuzo.studio@gmail.com
              </a>
            </div>
          </div>
        ) : isChangelog ? (
          <article class="rounded-3xl border border-gray-200 p-8 dark:border-gray-800 sm:p-12">
            <div class="flex items-center gap-3">
              <Icon name="tabler:sparkles" class="h-8 w-8 text-blue-600" />
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Shotera v7.2.0+</h2>
            </div>
            <p class="mt-5 leading-8 text-gray-600 dark:text-gray-300">{content.labels.releaseText}</p>
            <a
              class="mt-6 inline-flex font-semibold text-blue-700 underline underline-offset-4 dark:text-blue-300"
              href="https://github.com/mosuzo-studio/Shotera/releases"
            >
              GitHub Releases
            </a>
          </article>
        ) : (
          <div class="grid gap-6 md:grid-cols-3">
            {content.features.slice(0, isAboutOrServices ? 6 : 3).map((feature) => (
              <article class="rounded-2xl border border-gray-200 p-7 dark:border-gray-800">
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white">{feature.title}</h2>
                <p class="mt-3 leading-7 text-gray-600 dark:text-gray-300">{feature.description}</p>
              </article>
            ))}
          </div>
        )
      }

      <div class="mt-12 text-center">
        <a
          class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700"
          href={`/${locale}`}
        >
          <Icon name="tabler:arrow-left" class="h-5 w-5 rtl:rotate-180" />
          {content.labels.backHome}
        </a>
      </div>
    </div>
  </section>
</PageLayout>
