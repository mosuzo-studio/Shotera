---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { localizedPath, defaultLang, type Lang } from '~/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;

const metadata = {
  title: 'Pricing — Shotera',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Pricing"
    title="Start free, upgrade when you need to"
    subtitle="Everyday capture and annotation are free forever. Upgrade to Pro or Team when you need recording, AI cutout, and image translation. This is an early preview, not the final plan — features and prices may change before release."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Choose the plan that fits"
    subtitle="Buy once, no hidden fees"
    prices={[
      {
        title: 'Free',
        subtitle: 'Everything you need day to day',
        price: 0,
        period: 'Free forever',
        items: [
          { description: 'Region / window / full-screen capture' },
          { description: 'Smart window & element detection' },
          { description: 'Full annotation kit (arrows, boxes, text, highlights, blur)' },
          { description: 'Emoji stickers, magnifier, step numbers' },
          { description: 'Pin to screen' },
          { description: 'Basic offline OCR (daily limit)' },
          { description: 'Ongoing maintenance & updates' },
        ],
        callToAction: {
          text: 'Download free',
          href: 'https://github.com/mosuzo-studio/Shotera/releases',
        },
      },
      {
        title: 'Pro',
        subtitle: 'Advanced capture & AI',
        price: 29,
        period: 'One-time',
        items: [
          { description: 'Everything in Free' },
          { description: 'HD recording & GIF export' },
          { description: 'Unlimited AI background removal' },
          { description: 'Unlimited AI eraser / inpainting' },
          { description: 'Unlimited offline OCR' },
          { description: 'Image translation' },
          { description: 'Cloud sync for capture history' },
          { description: 'Buy once, use forever, free updates' },
        ],
        callToAction: {
          text: 'Buy now',
          href: 'https://github.com/mosuzo-studio/Shotera/releases',
        },
        hasRibbon: true,
        ribbonTitle: 'Popular',
      },
      {
        title: 'Team',
        subtitle: 'Enterprise-grade service & dedicated support',
        price: 39,
        period: '/ seat',
        items: [
          { description: 'Everything in Pro' },
          { description: 'Centralized licensing & management' },
          { description: 'Consolidated billing & invoicing' },
          { description: 'Dedicated bug & feature response channel' },
          { description: 'Top-tier technical support & after-sales service' },
          { description: 'Volume discounts for bulk purchases' },
        ],
        callToAction: {
          text: 'Contact us',
          href: localizedPath(lang, '/contact'),
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Why it's worth upgrading"
    subtitle="Pro makes the capturing, recording, and AI features you already use every day faster and more reliable."
    columns={2}
    items={[
      {
        title: 'Buy once, use forever',
        description:
          'Pro is a one-time $29 purchase — no annual fees, no subscriptions. Free updates for all future versions.',
        icon: 'tabler:receipt',
      },
      {
        title: 'Local-first & private',
        description:
          'AI cutout, eraser, and OCR all run on your device — nothing uploaded, your screenshots stay yours.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Licensed across devices',
        description: 'One license, activate on all your machines. Switch between work and home seamlessly.',
        icon: 'tabler:devices',
      },
      {
        title: 'Ready in seconds',
        description: 'Installs in seconds and works out of the box — no complex setup.',
        icon: 'tabler:download',
      },
      {
        title: 'Always improving',
        description: 'Every new feature and version update during your license, free.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Priority support',
        description: 'Pro and Team users get faster responses when it matters.',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Three steps to Pro"
    tagline="Quick and simple"
    isReversed={true}
    items={[
      {
        title: 'Download and install Shotera',
        icon: 'tabler:number-1',
      },
      {
        title: 'Choose Pro plan & purchase',
        icon: 'tabler:number-2',
      },
      {
        title: 'Activate license to unlock everything',
        icon: 'tabler:number-3',
      },
      {
        title: 'Start capturing and recording faster',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/workflow.png',
      alt: 'Upgrade flow',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Pricing FAQs"
    subtitle="A few things you might want to know about billing and licensing."
    columns={1}
    items={[
      {
        title: 'Is the Free plan really free?',
        description:
          'Yes. Capture, annotation, pinning, and basic offline OCR are free forever, with no time limit and no forced upgrades. Free users also benefit from ongoing maintenance and updates.',
      },
      {
        title: 'Is Pro a one-time purchase or a subscription?',
        description:
          'Pro is a one-time purchase of $29 — own it for life. No annual renewal needed. You get permanent access to your licensed version, plus free updates for future versions. Pro is for personal use only.',
      },
      {
        title: "What's the difference between Pro and Team?",
        description:
          'Team ($39/seat) is built for business and commercial teams. It includes centralized licensing, consolidated billing & invoicing, a dedicated bug & feature response channel, top-tier technical support and after-sales service. Volume discounts are available for bulk purchases.',
      },
      {
        title: 'How many devices does one license cover?',
        description:
          'A Pro license works across your personal devices. Team is licensed per seat for easy central management and billing.',
      },
      {
        title: 'What payment methods do you accept?',
        description: 'We accept major credit cards, PayPal, WeChat Pay, and Alipay for a secure, convenient checkout.',
      },
      {
        title: 'Can I get a refund?',
        description: 'Team licenses come with a 7-day refund policy. Contact us if you have any questions.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Make your screenshots more productive today"
    subtitle="Download free, install in seconds, upgrade whenever you're ready."
    actions={[
      {
        variant: 'primary',
        text: 'Download Shotera free',
        href: 'https://github.com/mosuzo-studio/Shotera/releases',
        icon: 'tabler:download',
      },
    ]}
  />
</Layout>
