---
import { publishedLocales } from '~/i18n/locales';

export function getStaticPaths() {
  return publishedLocales
    .filter((locale) => locale !== 'en' && locale !== 'zh-cn')
    .map((locale) => ({ params: { locale } }));
}

const target = '/versions';
const { locale } = Astro.params;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Shotera — Versions</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>Shotera versions — continue in English</a></p>
  </body>
</html>
