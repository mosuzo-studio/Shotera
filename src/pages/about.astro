---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import AboutBannerRandom from '~/components/common/AboutBannerRandom.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayoutV3.astro';
import { getSetupDownloadUrl } from '~/utils/download';

const setupUrl = await getSetupDownloadUrl();

const metadata = {
  title: 'About Shotera',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: '~/assets/images/about-hero.png',
      alt: 'Shotera at a glance: capture and annotation, stitched long screenshots, pinned references and AI cutout',
    }}
  >
    <Fragment slot="title">
      Make screenshots <br />
      <span class="text-accent dark:text-white">good enough to disappear</span>
    </Fragment>

    <Fragment slot="subtitle">
      Shotera started with a simple frustration: the captures we take dozens of times a day should feel faster and
      smoother. We're a small team of product people and engineers who lean on capture tools as heavily as anyone — and
      we built that obsession into every shortcut, every selection, every frame.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Shotera at a glance"
    stats={[
      { title: 'Languages', amount: '15' },
      { title: 'Rating', amount: '4.9 / 5' },
      { title: 'Offline AI', amount: '100%' },
      { title: 'Shortcut launch', amount: '<0.1s' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="What we stand by"
    subtitle="The better a tool feels, the less you notice it — that idea sits behind every decision we make."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Speed comes first',
        description:
          'One shortcut to summon it, automatic window and element detection, and exactly the frame you meant. Under a second from intent to capture.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Local-first, private by default',
        description:
          'OCR, cutout, and more run on-device wherever possible. Your screenshots stay off the cloud unless you say otherwise.',
        icon: 'tabler:lock',
      },
      {
        title: 'Restraint by design',
        description:
          'No feature bloat, no interrupting your flow. Common things are one click away; advanced ones show up only when you need them.',
        icon: 'tabler:sparkles',
      },
    ]}
  />

  <!-- Features3 Widget - L1 core capabilities ************** -->

  <Features3
    title="Core capabilities"
    subtitle="Capture, scrolling capture, pin, recording, offline OCR and on-device AI - the six things you reach for all day, one shortcut away."
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Capture',
        description:
          'Smart window and element detection, so the frame is ready before you drag. Finish by copying straight away, or open the annotation toolbar - two completion modes, your call.',
        icon: 'tabler:capture',
      },
      {
        title: 'Scrolling capture',
        description:
          'Scroll a page or a long chat and let Shotera stitch it into one long shot - auto-scroll or by hand, with a live preview.',
        icon: 'local:longshot',
      },
      {
        title: 'Pin to Desktop',
        description: 'Keep any screenshot floating on top for reference, arranged side by side without the clutter.',
        icon: 'tabler:pin',
      },
      {
        title: 'Recording & GIF',
        description:
          'Record your screen and export a lightweight GIF; cursor highlights and click cues keep demos clear.',
        icon: 'tabler:video',
      },
      {
        title: 'Offline OCR',
        description:
          'Turn the text inside a screenshot into editable copy, in several languages - recognised on your device, ready to paste.',
        icon: 'tabler:text-recognition',
      },
      {
        title: 'AI cutout & eraser',
        description:
          'AI cutout drops the background in one click and exports a transparent PNG; AI eraser clears away clutter and watermarks. Both run on local models - nothing is uploaded.',
        icon: 'tabler:wand',
      },
    ]}
    image={{
      src: '~/assets/images/about-cat-1.webp',
      alt: 'A kitten playing with floating glass capture cards',
    }}
  />

  <AboutBannerRandom />

  <!-- Features3 Widget - L2 more capabilities ************** -->

  <Features3
    title="More capabilities"
    subtitle="The details that make it stick - annotation, recognition, viewing and the settings around them."
    columns={3}
    items={[
      {
        title: 'Annotation tools',
        description:
          'Rectangle/ellipse, line/arrow, pen, highlighter, mosaic/blur, text, step number, emoji sticker, magnifier and eraser - annotate the moment you capture.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Emoji stickers',
        description:
          'Hundreds of emoji stickers - thumbs up, hearts, laughs, confetti - scale and place them anywhere to add a bit of fun.',
        icon: 'tabler:mood-smile',
      },
      {
        title: 'Image viewer & editor',
        description:
          'Open a shot or any image file in its own window - flip through the folder, zoom in, and touch up what you need. Common formats open as they are.',
        icon: 'tabler:photo',
      },
      {
        title: 'Image translation',
        description: 'Foreign text inside a screenshot, translated in place - copy the translation and carry on.',
        icon: 'tabler:language',
      },
      {
        title: 'QR & barcode scanning',
        description:
          'QR codes and barcodes read in place: links, Wi-Fi, contacts, product codes - copy the result in one click, entirely offline.',
        icon: 'tabler:qrcode',
      },
      {
        title: 'Custom capture',
        description: 'Fixed size, ratio, delay and screen coordinates - handy for assets and batch shots.',
        icon: 'tabler:crop',
      },
      {
        title: 'Multi-monitor',
        description:
          'Every screen in one coordinate space, so secondary and extended displays select correctly - and captures stay sharp on high-DPI panels.',
        icon: 'tabler:devices',
      },
      {
        title: 'Dark mode',
        description: 'Follow the system, or switch between light and dark by hand.',
        icon: 'tabler:moon',
      },
      {
        title: 'Presentation mode',
        description:
          'Tidy the desktop in one keystroke - windows, icons and wallpaper - and put it all back afterwards.',
        icon: 'tabler:presentation',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our values"
    subtitle="Building a tool and using one are the same thing to us. We work in what we make, every day."
    items={[
      {
        title: 'Built for real work',
        description:
          'Every feature comes from a real pain point — writing docs, annotating design specs, recording repros, reading foreign material. We use it first, then hand it to you.',
      },
      {
        title: 'Always refining',
        description:
          'Shortcut feel, edge snapping on selections, recording size vs. clarity — we keep tuning the details until they feel right.',
      },
      {
        title: 'Respect for users',
        description:
          "No bundleware, no nagging popups, no quietly uploading your data. Core features stay free — that's our promise.",
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="How we got here"
    subtitle="From a tool we built for ourselves to one people rely on every day."
    isReversed={true}
    callToAction={{
      text: 'Download Shotera free',
      href: setupUrl,
    }}
    items={[
      {
        title: 'Started with our own need',
        description: "We couldn't find a capture tool that was fast and smooth enough, so we wrote one.",
        icon: 'tabler:seeding',
      },
      {
        title: 'Grown by our users',
        description:
          'Scrolling capture, AI cutout, offline OCR, image translation — so many features came straight from user feedback.',
        icon: 'tabler:users',
      },
      {
        title: 'Reaching more people',
        description:
          'Today Shotera speaks 15 interface languages and keeps growing — with the same goal: make screenshots simple.',
        icon: 'tabler:world',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Get in touch"
    tagline="Reach us anytime"
    columns={2}
    items={[
      {
        title: 'GitHub',
        description:
          '<a class="font-semibold text-blue-700 underline underline-offset-4 dark:text-blue-300" href="https://github.com/mosuzo-studio/Shotera">mosuzo-studio/Shotera</a> — bug reports, feature requests, and every release.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Email support',
        description:
          'Hit a problem or have a feature idea? Email <a class="font-semibold text-blue-700 underline underline-offset-4 dark:text-blue-300" href="mailto:mosuzo.studio@gmail.com">mosuzo.studio@gmail.com</a> — we read and reply to every one.',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
