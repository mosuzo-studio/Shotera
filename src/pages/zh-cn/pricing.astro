---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { localizedPath, defaultLang, type Lang } from '~/i18n/utils';

const lang = (Astro.currentLocale ?? defaultLang) as Lang;

const metadata = {
  title: '价格 — Shotera',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="价格方案"
    title="免费开始，按需升级"
    subtitle="日常截图与标注永久免费。需要录屏、AI 抠图、图片翻译等进阶能力时，升级到专业版或团队版。当前仅为提前预览，并非最终方案，功能与价格在正式发布前可能调整。"
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="选择适合你的方案"
    subtitle="一次买断，无隐藏收费"
    prices={[
      {
        title: '免费版',
        subtitle: '满足日常截图所需',
        price: 0,
        period: '永久免费',
        items: [
          { description: '区域 / 窗口 / 全屏截图' },
          { description: '智能窗口与元素检测' },
          { description: '丰富的标注工具（箭头、方框、文字、高亮、马赛克等）' },
          { description: '表情贴纸、Emoji、放大镜、序号标注' },
          { description: '贴图钉屏' },
          { description: '基础离线 OCR（每日限量）' },
          { description: '持续维护与版本更新' },
        ],
        callToAction: {
          text: '免费下载',
          href: 'https://github.com/mosuzo-studio/Shotera/releases',
        },
      },
      {
        title: '专业版',
        subtitle: '进阶截屏与 AI 能力',
        price: 29,
        period: '买断',
        items: [
          { description: '包含免费版全部功能' },
          { description: '高清录屏与 GIF 导出' },
          { description: 'AI 智能抠图，无限次' },
          { description: 'AI 擦图 / 修图，无限次' },
          { description: '离线 OCR 无限使用' },
          { description: '图片翻译' },
          { description: '截图 / 录屏历史记录云同步' },
          { description: '一次买断，终身使用，免费更新' },
        ],
        callToAction: {
          text: '立即购买',
          href: 'https://github.com/mosuzo-studio/Shotera/releases',
        },
        hasRibbon: true,
        ribbonTitle: '推荐',
      },
      {
        title: '团队版',
        subtitle: '企业级服务与专属支持',
        price: 39,
        period: '/ 人',
        items: [
          { description: '包含专业版全部功能' },
          { description: '团队统一授权与管理' },
          { description: '集中计费与发票' },
          { description: '专属 Bug 与需求响应通道' },
          { description: '最高级技术支持与售后服务' },
          { description: '批量采购享受优惠价格' },
        ],
        callToAction: {
          text: '联系我们',
          href: localizedPath(lang, '/contact'),
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="为什么值得升级"
    subtitle="专业版把你每天都在做的截图、录屏、识别做到更快、更省心"
    columns={2}
    items={[
      {
        title: '一次买断，终身使用',
        description: '专业版 $29 一次性付费，终身使用，无年费、无订阅，且免费获取后续版本更新。',
        icon: 'tabler:receipt',
      },
      {
        title: '本地优先，隐私安心',
        description: 'AI 抠图、擦图、OCR 等核心能力本地运行，不联网、不上传，你的截图只属于你。',
        icon: 'tabler:shield-lock',
      },
      {
        title: '多端授权',
        description: '一个授权可在你的多台设备上激活使用，工作、家用无缝切换。',
        icon: 'tabler:devices',
      },
      {
        title: '下载即用',
        description: '几秒安装、开箱即用，无需复杂配置，装好就能上手。',
        icon: 'tabler:download',
      },
      {
        title: '持续更新',
        description: '买断期内免费获取所有新功能与版本升级，越用越好用。',
        icon: 'tabler:refresh',
      },
      {
        title: '优先支持',
        description: '专业版与团队版用户享受优先响应，问题第一时间得到解答。',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="三步用上专业版"
    tagline="简单快捷"
    isReversed={true}
    items={[
      {
        title: '下载并安装 Shotera',
        icon: 'tabler:number-1',
      },
      {
        title: '选择专业版方案并购买',
        icon: 'tabler:number-2',
      },
      {
        title: '激活授权，解锁全部功能',
        icon: 'tabler:number-3',
      },
      {
        title: '开始高效截图与录屏',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/workflow.png',
      alt: '升级流程示意',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="价格常见问题"
    subtitle="关于付费与授权，你可能想了解的一些问题。"
    columns={1}
    items={[
      {
        title: '免费版会一直免费吗？',
        description:
          '会。截图、标注、贴图钉图以及基础的离线 OCR 等日常功能永久免费，无使用期限，也不会强制升级。我们持续维护和更新，免费用户同样受益。',
      },
      {
        title: '专业版是买断制还是订阅制？',
        description:
          '专业版是一次性买断制，$29 终身使用，无需每年续费。一次付费后，你拥有该版本的永久使用权，且后续版本更新免费。专业版仅限个人用户使用。',
      },
      {
        title: '团队版和专业版有什么区别？',
        description:
          '团队版（$39/人）支持商业公司和团队使用，提供团队统一授权管理、集中计费与发票、专属 Bug 与需求响应通道、最高级技术支持与售后服务。批量采购可享受优惠价格。',
      },
      {
        title: '一个授权可以在几台设备上使用？',
        description: '专业版授权可在你个人的多台设备上激活使用。团队版则按人数授权，方便统一管理与计费。',
      },
      {
        title: '支持哪些支付方式？',
        description: '我们支持微信支付、支付宝以及主流信用卡，交易过程安全便捷。',
      },
      {
        title: '可以退款吗？',
        description: '团队版提供 7 天无理由退款。如有疑问可随时联系我们。',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="现在就让截图更高效"
    subtitle="免费下载，几秒安装，随时升级解锁完整能力。"
    actions={[
      {
        variant: 'primary',
        text: '免费下载 Shotera',
        href: 'https://github.com/mosuzo-studio/Shotera/releases',
        icon: 'tabler:download',
      },
    ]}
  />
</Layout>
