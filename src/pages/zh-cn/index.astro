---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import DownloadButtons from '~/components/ui/DownloadButtons.astro';

const metadata = {
  title: 'Shotera — 更快、更聪明的截图与录屏工具',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'Shotera 工具箱：截图、滚动截图、标注、录屏、AI 抠图、离线 OCR、二维码 / 条码识别、图片翻译与贴图 / 钉图',
    }}
  >
    <DownloadButtons
      slot="actions"
      language="zh-cn"
      downloadLabel="免费下载"
      moreVersionsLabel="更多版本"
      storeAriaLabel="从 Microsoft Store 获取 Shotera"
      downloadAriaLabel="下载最新的 Shotera Windows 安装包"
      moreVersionsAriaLabel="更多下载选项"
      recommendLabel="推荐"
      msiLabel="MSI 安装包"
      portableLabel="免安装版（.7z）"
      allVersionsLabel="在 GitHub 查看全部版本"
      footnoteLabel="想要更轻量？了解 Shotera Lite（约 17 MB）→"
      footnoteHref="/zh-cn/versions/"
    />

    <Fragment slot="title">
      截图、录屏、<span class="text-accent dark:text-white">AI 能力</span><br class="hidden md:inline" />
      一个快捷键全搞定
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Shotera</span> 将截图标注、滚动截图、录屏、AI 抠图、AI 擦图、离线 OCR、图片翻译与贴图钉图
        整合于同一窗口，一次快捷键即可完成整段流程。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Shotera：截图录屏，一步到位。</span>
      让每天要重复许多次的截图与录屏，更迅速，也更省事。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="产品理念：" description="又快、又准、又顺手——Shotera 的全部设计理念。" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="核心功能"
    title="一个快捷键，搞定所有截图任务"
    subtitle="截图、滚动截图、录屏、文字识别、抠图、翻译，无需再打开其他软件，同一窗口即可完成全部处理。"
    items={[
      {
        title: '智能截图',
        description: '按下快捷键，要截的窗口或元素已经选好了。识别精确到像素，基本不用手动拖框。',
        icon: 'tabler:capture',
      },
      {
        title: '滚动截图',
        description: '页面再长也能一张装下：自动滚或自己滚，边滚边拼，长图实时可见。',
        icon: 'local:longshot',
      },
      {
        title: '录屏 & GIF',
        description: '最高 4K、30/60 fps、不限时长，录完直接导出 MP4 或轻量 GIF，发出去就能播。',
        icon: 'tabler:video',
      },
      {
        title: 'AI 抠图',
        description: '一键把主体从画面里提出来：人像、商品、Logo，导出透明 PNG。不用 PS，也不上传。',
        icon: 'tabler:scissors',
      },
      {
        title: 'AI 擦图',
        description: '多余物体、水印、瑕疵，刷一下就消失，AI 自动补上背景。全程离线。',
        icon: 'tabler:eraser',
      },
      {
        title: '离线 OCR 文字识别',
        description: '截图里的字直接变成可选中、可复制的文本：中英混排、代码、表格都行，全程不联网。',
        icon: 'tabler:text-recognition',
      },
      {
        title: '二维码 / 条码识别',
        description: '截图里的二维码、条码就地识别：链接、WiFi、联系人、商品条码，结果一键复制，全程离线。',
        icon: 'tabler:qrcode',
      },
      {
        title: '图片翻译',
        description: '截图里的外文就地翻成你的语言，译文直接复制走。',
        icon: 'tabler:language',
      },
      {
        title: '贴图 / 钉图',
        description: '把截图钉在屏幕最上层：边打字、边对照、边滚动，不用来回切窗口。',
        icon: 'tabler:pin',
      },
      {
        title: '图片查看',
        description:
          '截图和图片文件可以在独立查看窗口里打开：同目录翻页、缩放细看、顺手改两笔，常见格式都能直接读。',
        icon: 'tabler:photo',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="截图"
    title="一按就到手，边界刚刚好"
    items={[
      {
        title: '划过即吸附',
        description: '鼠标划过，Shotera 自动吸附到下面的窗口或元素，不用手动对齐边框。',
      },
      {
        title: '一整套标注工具',
        description:
          '箭头、方框、文字、高亮、马赛克、序号、表情、放大镜，截完立刻就能标重点，一眼看明白。',
      },
      {
        title: '马赛克与高亮',
        description: '敏感信息一键盖住，重点区域同时圈出来，一个动作搞定两件事。',
      },
    ]}
    image={{
      src: '~/assets/images/capture-demo.png',
      alt: '截图与标注功能演示',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">为高频使用而设计</h3>
      快捷键随手唤起，截图、标注、复制一气呵成，把打断思路的操作降到最低。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="滚动截图"
    title="页面再长，也一张装下"
    items={[
      {
        title: '自动滚 / 自己滚',
        description: '让 Shotera 自动往下滚，或自己动手滚；两种方式都会边滚边拼。',
      },
      {
        title: '拼接过程实时可见',
        description: '选区旁边有个预览小窗随拼接一起变长，看到想要的长度就停。',
      },
      {
        title: '拼接看不出接缝',
        description: '相邻画面自动对齐、融合，拼出来的长图像原本就是一整页。',
      },
      {
        title: '复制或存盘',
        description: '拼好直接复制到剪贴板或存成文件，贴进文档、聊天、工单都行。',
      },
    ]}
    image={{
      src: '~/assets/images/longshot-demo.png',
      alt: '滚动截图把长页面拼接成一张长图',
    }}
  >
    <Fragment slot="content">长网页、长聊天记录、整份文档——从上到下一张截全。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    tagline="录屏"
    title="4K 录屏，想录多久录多久"
    items={[
      {
        title: '720p 到 4K',
        description: '按任务挑分辨率：720p、1080p、2K、4K 都行，帧率 30 / 60 fps，且不限录制时长。',
      },
      {
        title: '导出轻量 GIF',
        description: '把操作过程压成体积小巧的 GIF，贴进文档、聊天、Issue，无需播放器，打开即看。',
      },
      {
        title: '记录光标与点击',
        description: '指针高亮加上点击提示，演示里的每一步都看得清。',
      },
      {
        title: 'MP4 还是 GIF 由你定',
        description: '格式与分辨率自己选，在画质和文件大小之间取平衡。',
      },
    ]}
    image={{
      src: '~/assets/images/recording-demo.png',
      alt: '录屏与 GIF 导出演示',
    }}
  >
    <Fragment slot="content">把「说不清」的操作，变成一段一看就懂的演示。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="AI 能力"
    title="AI 帮你把截图收尾"
    items={[
      {
        title: '一键抠出主体',
        description: '人像、商品几秒钟变成透明 PNG——不用 PS，不用上传，也不用等服务器。',
      },
      {
        title: '擦掉不该有的东西',
        description: '物体、水印、瑕疵，涂一下，AI 自然补上背景，离线完成。',
      },
      {
        title: '提取图里的文字',
        description: 'OCR 在本机运行，一键变成可编辑、可复制的文本。',
      },
      {
        title: '随时换更好的模型',
        description: '抠图和擦图都能换成更新的模型，不用等应用更新。',
      },
    ]}
    image={{
      src: '~/assets/images/ai-demo.png',
      alt: 'AI 抠图与 OCR 演示',
    }}
  >
    <Fragment slot="content">AI 抠图、擦图、OCR 全程本地运行，隐私与智能兼得。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="从截屏到发出去，只要三步。"
    items={[
      {
        title: '第 1 步：<span class="font-medium">按下快捷键</span>',
        description: '在任何界面唤起 Shotera，鼠标一停，要截的窗口或元素已经识别好了。',
        icon: 'tabler:keyboard',
      },
      {
        title: '第 2 步：<span class="font-medium">标注 / 识别 / 处理</span>',
        description: '标重点、跑 OCR、抠个图、翻个译，都在同一个窗口里完成。',
        icon: 'tabler:wand',
      },
      {
        title: '第 3 步：<span class="font-medium">复制 / 保存 / 钉图</span>',
        description: '复制到剪贴板、存到本地，或钉在屏幕最上层随时对照。',
        icon: 'tabler:share',
      },
      {
        title: '搞定！',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/workflow.png',
      alt: 'Shotera 使用流程',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="这些小细节，用过就回不去"
    subtitle="让人一用就离不开的，往往是这些藏在细节里的设计。"
    tagline="更多功能"
    items={[
      {
        title: '表情贴纸与 Emoji',
        description: '一键贴上 Emoji 贴纸，让干巴巴的截图也能表达情绪。',
        icon: 'tabler:mood-happy',
      },
      {
        title: '放大镜',
        description: '把关键细节放大，谁都不会看漏。',
        icon: 'tabler:zoom-in',
      },
      {
        title: '序号标注',
        description: '按顺序标好 1、2、3，教程和操作指引一目了然。',
        icon: 'tabler:list-numbers',
      },
      {
        title: '贴图 / 钉图',
        description: '参考图浮在最上层，边看边做，不用来回切窗口。',
        icon: 'tabler:pin',
      },
      {
        title: '快捷键自定义',
        description: '常用操作绑成顺手的按键组合，效率藏在肌肉记忆里。',
        icon: 'tabler:keyboard',
      },
      {
        title: '历史记录',
        description: '每次截图和录制自动留档，手滑也不会丢东西。',
        icon: 'tabler:history',
      },
      {
        title: '多显示器支持',
        description: '多屏、混合高 DPI 环境同样精准，每块屏幕都截得准。',
        icon: 'tabler:devices',
      },
      {
        title: '本地优先 · 隐私安心',
        description: 'OCR 与 AI 能力都在本机运行，不上传任何内容，截图只属于你。',
        icon: 'tabler:lock',
      },
      {
        title: '轻量不占资源',
        description: '秒开、占用极小，常驻后台也不拖慢电脑。',
        icon: 'tabler:bolt',
      },
      {
        title: '深色模式',
        description: '跟随系统主题自动切换，白天夜里都护眼。',
        icon: 'tabler:moon',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="使用技巧与更新"
    information={`在博客里，我们会分享 Shotera 的使用技巧、快捷键玩法、版本更新与效率工作流，
                        帮你把这款小工具的价值榨到最大。
                `}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '界面语言', amount: '15 种' },
      { title: '好评率', amount: '4.9 / 5' },
      { title: '离线 AI 处理', amount: '100%' },
      { title: '快捷键唤起', amount: '<0.1s' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction id="download">
    <DownloadButtons
      slot="actions"
      language="zh-cn"
      downloadLabel="免费下载"
      moreVersionsLabel="更多版本"
      storeAriaLabel="从 Microsoft Store 获取 Shotera"
      downloadAriaLabel="下载最新的 Shotera Windows 安装包"
      moreVersionsAriaLabel="更多下载选项"
      recommendLabel="推荐"
      msiLabel="MSI 安装包"
      portableLabel="免安装版（.7z）"
      allVersionsLabel="在 GitHub 查看全部版本"
      footnoteLabel="想要更轻量？了解 Shotera Lite（约 17 MB）→"
      footnoteHref="/zh-cn/versions/"
    />

    <Fragment slot="title"
      >让每天的截图，<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">都更快一步</span></Fragment
    >

    <Fragment slot="subtitle">
      免费下载，几秒安装。<br class="hidden md:inline" />核心功能永久免费。
    </Fragment>
  </CallToAction>
</Layout>
