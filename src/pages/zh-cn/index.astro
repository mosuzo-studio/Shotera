---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import DownloadButtons from '~/components/ui/DownloadButtons.astro';

const metadata = {
  title: 'Shotera — 更快、更聪明的截图与录屏工具',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

  <!-- Hero Widget ******************* -->

  <Hero image={{ src: '~/assets/images/hero-image.png', alt: 'Shotera 截图录屏工具界面' }}>
    <DownloadButtons
      slot="actions"
      language="zh-cn"
      downloadLabel="免费下载"
      moreVersionsLabel="更多版本"
      storeAriaLabel="从 Microsoft Store 获取 Shotera"
      downloadAriaLabel="下载最新的 Shotera Windows 安装包"
      moreVersionsAriaLabel="更多下载选项"
      recommendLabel="推荐"
      msiLabel="MSI 安装包"
      portableLabel="免安装版（.7z）"
      allVersionsLabel="在 GitHub 查看全部版本"
      footnoteLabel="想要更轻量？了解 Shotera Lite（约 17 MB）→"
      footnoteHref="/zh-cn/versions/"
    />

    <Fragment slot="title">
      截图、录屏、<span class="text-accent dark:text-white">AI 识图</span><br class="hidden md:inline" />
      一个快捷键全搞定
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Shotera</span> 是一款为效率而生的桌面截图与录屏工具，集截图标注、录屏导出 GIF、AI 抠图、AI
        擦图（修图）、离线 OCR、图片翻译、贴图钉图于一身。</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Shotera：截图录屏，一步到位。</span>
      让每一次「截个图」都又快又顺手。
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="产品理念：" description="又快、又准、又顺手——把截图这件小事做到极致" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="核心功能"
    title="一个快捷键，搞定所有截图任务"
    subtitle="截图、录屏、读字、抠图、翻译，不用再开第二个软件——全部在本机完成，还很快。"
    items={[
      {
        title: '智能截图',
        description: '按下快捷键，要截的东西已经选中了。窗口与界面元素自动识别到像素级，基本不用手动拖框。',
        icon: 'tabler:capture',
      },
      {
        title: '录屏 & GIF',
        description: '最高 4K、无时长限制，录完直接导出 MP4 或轻量 GIF，发出去就能播。',
        icon: 'tabler:video',
      },
      {
        title: 'AI 抠图',
        description: '一键把主体从画面里提出来——人像、商品、Logo，导出透明 PNG。不用 PS，也不上传。',
        icon: 'tabler:scissors',
      },
      {
        title: 'AI 擦图 / 修图',
        description: '多余物体、水印、瑕疵刷一下就没了，AI 自动补上背景。全程离线，隐私无忧。',
        icon: 'tabler:eraser',
      },
      {
        title: '离线 OCR 文字识别',
        description: '截图里的字直接变成可选中、可复制的文本，中英混排、代码、表格都行，全程不联网。',
        icon: 'tabler:text-recognition',
      },
      {
        title: '图片翻译',
        description: '截图里的外文就地翻译成你的语言，译文可以直接复制走。',
        icon: 'tabler:language',
      },
      {
        title: '贴图 / 钉图',
        description: '把截图钉在屏幕最上层，边打字、边对照、边滚动，不用来回切窗口。',
        icon: 'tabler:pin',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="截图"
    title="一按就到手，边界刚刚好"
    items={[
      {
        title: '划过即吸附',
        description: '鼠标划过，Shotera 自动吸附到下面的窗口或元素，不用手动对齐边框。',
      },
      {
        title: '一整套标注工具',
        description:
          '箭头、方框、文字、高亮、马赛克、序号、表情、放大镜，截完立刻就能标重点，一眼看明白。',
      },
      {
        title: '马赛克与高亮',
        description: '敏感信息一键盖住，重点区域同时圈出来，一个动作搞定两件事。',
      },
    ]}
    image={{
      src: '~/assets/images/capture-demo.png',
      alt: '截图与标注功能演示',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">为高频使用而设计</h3>
      快捷键随手唤起，截图、标注、复制一气呵成，把打断思路的操作降到最低。
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="录屏"
    title="4K 录屏，想录多久录多久"
    items={[
      {
        title: '1080p / 2K / 4K',
        description: '按需选分辨率，高帧率输出，录制时长不设限制。',
      },
      {
        title: '导出轻量 GIF',
        description: '把操作过程压成体积小巧的 GIF，贴进文档、聊天、Issue，无需播放器，打开即看。',
      },
      {
        title: '记录光标与点击',
        description: '指针高亮加上点击提示，演示里的每一步都看得清。',
      },
      {
        title: 'MP4 还是 GIF 由你定',
        description: '格式与分辨率自己选，在画质和文件大小之间取平衡。',
      },
    ]}
    image={{
      src: '~/assets/images/recording-demo.png',
      alt: '录屏与 GIF 导出演示',
    }}
  >
    <Fragment slot="content">把「说不清」的操作，变成一段一看就懂的演示。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    tagline="AI 能力"
    title="AI 帮你把截图收尾"
    items={[
      {
        title: '一键抠出主体',
        description: '人像、商品几秒钟变成透明 PNG——不用 PS，不用上传，也不用等服务器。',
      },
      {
        title: '擦掉不该有的东西',
        description: '物体、水印、瑕疵，涂一下，AI 自然补上背景，离线完成。',
      },
      {
        title: '提取图里的文字',
        description: 'OCR 在本机运行，一键变成可编辑、可复制的文本。',
      },
      {
        title: '随时换更好的模型',
        description: '抠图和擦图都能换成更新的模型，不用等应用更新。',
      },
    ]}
    image={{
      src: '~/assets/images/ai-demo.png',
      alt: 'AI 抠图与 OCR 演示',
    }}
  >
    <Fragment slot="content">AI 抠图、修图、OCR 全程本地运行，隐私与智能兼得。</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="从截屏到发出去，只要三步。"
    items={[
      {
        title: '第 1 步：<span class="font-medium">按下快捷键</span>',
        description: '在任何界面唤起 Shotera，鼠标一停，要截的窗口或元素已经识别好了。',
        icon: 'tabler:keyboard',
      },
      {
        title: '第 2 步：<span class="font-medium">标注 / 识别 / 处理</span>',
        description: '标重点、跑 OCR、抠个图、翻个译，都在同一个窗口里完成。',
        icon: 'tabler:wand',
      },
      {
        title: '第 3 步：<span class="font-medium">复制 / 保存 / 钉图</span>',
        description: '复制到剪贴板、存到本地，或钉在屏幕最上层随时对照。',
        icon: 'tabler:share',
      },
      {
        title: '搞定！',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/workflow.png',
      alt: 'Shotera 使用流程',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="这些小细节，用过就回不去"
    subtitle="让人一用就离不开的，往往是这些藏在细节里的设计。"
    tagline="更多功能"
    items={[
      {
        title: '表情贴纸与 Emoji',
        description: '一键贴上 Emoji 贴纸，让干巴巴的截图也能表达情绪。',
        icon: 'tabler:mood-happy',
      },
      {
        title: '放大镜',
        description: '把关键细节放大，谁都不会看漏。',
        icon: 'tabler:zoom-in',
      },
      {
        title: '序号标注',
        description: '按顺序标好 1、2、3，教程和操作指引一目了然。',
        icon: 'tabler:list-numbers',
      },
      {
        title: '贴图钉屏',
        description: '参考图浮在最上层，边看边做，不用来回切窗口。',
        icon: 'tabler:pin',
      },
      {
        title: '快捷键自定义',
        description: '常用操作绑成顺手的按键组合，效率藏在肌肉记忆里。',
        icon: 'tabler:keyboard',
      },
      {
        title: '历史记录',
        description: '每次截图和录制自动留档，手滑也不会丢东西。',
        icon: 'tabler:history',
      },
      {
        title: '多显示器支持',
        description: '多屏、混合高 DPI 环境同样精准，每块屏幕都截得准。',
        icon: 'tabler:devices',
      },
      {
        title: '本地优先 · 隐私安心',
        description: 'OCR 与 AI 能力都在本机运行，不上传任何内容，截图只属于你。',
        icon: 'tabler:lock',
      },
      {
        title: '轻量不占资源',
        description: '秒开、占用极小，常驻后台也不拖慢电脑。',
        icon: 'tabler:bolt',
      },
      {
        title: '深色模式',
        description: '跟随系统主题自动切换，白天夜里都护眼。',
        icon: 'tabler:moon',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="使用技巧与更新"
    information={`在博客里，我们会分享 Shotera 的使用技巧、快捷键玩法、版本更新与效率工作流，
                        帮你把这款小工具的价值榨到最大。
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="常见问题"
    subtitle="关于 Shotera 你可能想知道的那些事。"
    tagline="常见问题"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Shotera 支持哪些操作系统？',
        description:
          '目前支持 Windows 桌面平台，安装包体积小、启动快、离线可用，下载后即可使用。更多 macOS、Linux 等平台正在规划中。',
      },
      {
        title: 'Shotera 支持哪些界面语言？',
        description:
          '已新增繁体中文、日语、巴西葡萄牙语、西班牙语、德语、法语、意大利语、韩语、俄语、阿拉伯语、荷兰语、波兰语和瑞典语。加上英语和简体中文，Shotera 目前共支持 15 种界面语言。',
      },
      {
        title: 'OCR 和 AI 抠图需要联网吗？',
        description:
          '不需要。OCR 文字识别、AI 抠图、AI 擦图（修图）均为离线本地运行，不联网、不上传，隐私更有保障。图片翻译功能走云端 API，遵守对应云厂商的隐私协议。',
      },
      {
        title: 'Shotera 是免费的吗？',
        description:
          '核心的截图、标注、贴图功能免费使用。录屏、AI 抠图、AI 擦图、图片翻译等进阶能力提供更完整的体验，具体可查看价格页面。',
      },
      {
        title: '录屏可以导出成 GIF 吗？',
        description:
          '可以。录制完成后可一键导出为 MP4 或体积小巧的 GIF，支持 1080p 至 4K 超清分辨率，无录制时长限制，方便贴进文档、聊天工具和问题反馈中。',
      },
      {
        title: '会占用很多系统资源吗？',
        description: '不会。Shotera 以轻量为设计目标，常驻内存极小、启动迅速，即使长期后台待命也几乎无感。',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: '界面语言', amount: '15 种' },
      { title: '好评率', amount: '4.9 / 5' },
      { title: 'AI 离线处理', amount: '100%' },
      { title: '快捷键唤起', amount: '<0.1s' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction id="download">
    <DownloadButtons
      slot="actions"
      language="zh-cn"
      downloadLabel="免费下载"
      moreVersionsLabel="更多版本"
      storeAriaLabel="从 Microsoft Store 获取 Shotera"
      downloadAriaLabel="下载最新的 Shotera Windows 安装包"
      moreVersionsAriaLabel="更多下载选项"
      recommendLabel="推荐"
      msiLabel="MSI 安装包"
      portableLabel="免安装版（.7z）"
      allVersionsLabel="在 GitHub 查看全部版本"
      footnoteLabel="想要更轻量？了解 Shotera Lite（约 17 MB）→"
      footnoteHref="/zh-cn/versions/"
    />

    <Fragment slot="title"
      >现在就让截图变得<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">又快又聪明</span></Fragment
    >

    <Fragment slot="subtitle">
      免费下载，几秒安装，立刻上手。<br class="hidden md:inline" />把每天都要做的「截个图」，交给更懂你的工具。
    </Fragment>
  </CallToAction>
</Layout>
