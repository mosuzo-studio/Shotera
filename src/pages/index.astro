---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import DownloadButtons from '~/components/ui/DownloadButtons.astro';

const metadata = {
  title: 'Shotera — Faster, smarter screenshots and screen recording',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

  <!-- Hero Widget ******************* -->

  <Hero
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'Shotera tools on screen: capture, scrolling capture, annotation, recording, AI cutout, text and QR reading, translation',
    }}
  >
    <DownloadButtons
      slot="actions"
      language="en-us"
      downloadLabel="Download free"
      moreVersionsLabel="More versions"
      storeAriaLabel="Get Shotera from Microsoft Store"
      downloadAriaLabel="Download the latest Shotera installer for Windows"
      moreVersionsAriaLabel="More download options"
      recommendLabel="Recommended"
      msiLabel="MSI installer"
      portableLabel="Portable (.7z)"
      allVersionsLabel="All versions on GitHub"
      footnoteLabel="Prefer something lighter? See Shotera Lite (~17 MB) →"
      footnoteHref="/versions/"
    />

    <Fragment slot="title">
      Screenshots, screen recording, <span class="text-accent dark:text-white">AI magic</span><br
        class="hidden md:inline"
      />
      all from a single shortcut
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Shotera</span> is a desktop capture tool built for people who screenshot all day. Annotate,
        record to GIF, AI cutout, AI eraser (inpainting), offline OCR, image translation, and pin references — without leaving
        your flow.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Shotera: capture, record, done.</span>
      Everything you reach for a dozen times a day, a little faster.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Philosophy:" description="Fast, precise, and out of your way — that's the whole idea" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Core features"
    title="Every screenshot task, one shortcut away"
    subtitle="Grab, record, read text, cut out a subject, translate — without opening anything else. It all runs on your PC and stays fast."
    items={[
      {
        title: 'Smart capture',
        description:
          'One key, and the right thing is already selected. Shotera detects windows and UI elements down to the pixel, so you rarely drag a box by hand.',
        icon: 'tabler:capture',
      },
      {
        title: 'Scrolling capture',
        description:
          'A page taller than the screen still fits in one shot — scroll by hand or let Shotera auto-scroll, and watch the long image stitch together as it grows.',
        icon: 'local:longshot',
      },
      {
        title: 'Screen recording & GIF',
        description:
          'Record up to 4K with no time limit, then export MP4 or a lightweight GIF that plays the moment it loads.',
        icon: 'tabler:video',
      },
      {
        title: 'AI background removal',
        description:
          'One click lifts the subject out of the shot — people, products, logos — as a transparent PNG. No Photoshop, and nothing uploaded.',
        icon: 'tabler:scissors',
      },
      {
        title: 'AI eraser / inpainting',
        description:
          'Brush away objects, watermarks, or blemishes and let the AI rebuild what was behind them. Fully offline.',
        icon: 'tabler:eraser',
      },
      {
        title: 'Offline OCR',
        description:
          'Turn any screenshot into selectable text — mixed languages, code, and tables included. Nothing leaves your device.',
        icon: 'tabler:text-recognition',
      },
      {
        title: 'QR & barcode scanning',
        description:
          'Decode the code inside any screenshot — links, Wi-Fi, contacts, product barcodes — and copy what it holds. All offline.',
        icon: 'tabler:qrcode',
      },
      {
        title: 'Image translation',
        description:
          'Read the text inside a screenshot in your language, then copy the translation straight into your work.',
        icon: 'tabler:language',
      },
      {
        title: 'Pin to screen',
        description:
          'Keep the shot floating on top while you type, compare, or scroll. Resize and arrange it without juggling windows.',
        icon: 'tabler:pin',
      },
      {
        title: 'Image viewer',
        description:
          'Open any shot or image file in its own viewer window — step through the folder, zoom in, and touch up what you need without launching another app. The common formats open straight away.',
        icon: 'tabler:photo',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Capture"
    title="Grab it in one press, frame it exactly"
    items={[
      {
        title: 'Hover to snap',
        description:
          'Hover, and Shotera locks onto the window or element underneath — no dragging to line things up.',
      },
      {
        title: 'A full annotation kit',
        description:
          'Arrows, boxes, text, highlights, blur, step numbers, emoji, magnifier — mark it up the moment you capture it, so the point lands instantly.',
      },
      {
        title: 'Blur and highlight',
        description: 'Hide the sensitive parts and point at the important ones in the same motion.',
      },
    ]}
    image={{
      src: '~/assets/images/capture-demo.png',
      alt: 'Capture and annotation demo',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Built for constant use</h3>
      Trigger it with a shortcut, then capture, annotate, and copy in one uninterrupted motion.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="Scrolling capture"
    title="A page taller than the screen, in one shot"
    items={[
      {
        title: 'Auto-scroll, or scroll it yourself',
        description:
          'Let Shotera walk the page down for you, or scroll by hand — either way the frames are captured as you go.',
      },
      {
        title: 'Watch it stitch as it grows',
        description:
          'A live preview sits beside the selection and gets longer with every frame, so you can stop the moment the whole page is in.',
      },
      {
        title: 'No visible seams',
        description:
          'Neighbouring frames are matched and blended together, so the finished long shot reads as one continuous page.',
      },
      {
        title: 'Copy it or save it',
        description:
          'Send the long shot straight to the clipboard or save it to disk — ready for docs, chat, and bug reports.',
      },
    ]}
    image={{
      src: '~/assets/images/longshot-demo.png',
      alt: 'Scrolling capture stitching a long page into a single image',
    }}
  >
    <Fragment slot="content">Whole pages, long chats, and full documents — captured top to bottom in one image.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    tagline="Recording"
    title="Record in 4K, for as long as it takes"
    items={[
      {
        title: '480p through 4K',
        description:
          'Pick the resolution that fits the job — 480p, 720p, 1080p, 2K, or 4K — at 30 or 60 fps, with no recording time limit.',
      },
      {
        title: 'Export to GIF',
        description: 'Drop a lightweight GIF into docs, chats, or issues. No player needed — it plays the moment it loads.',
      },
      {
        title: 'Show the cursor and clicks',
        description: 'Pointer highlights and click cues make every step of a demo obvious.',
      },
      {
        title: 'MP4 or GIF, your call',
        description: 'Choose the format and resolution that balance quality and file size for the job at hand.',
      },
    ]}
    image={{
      src: '~/assets/images/recording-demo.png',
      alt: 'Screen recording and GIF export demo',
    }}
  >
    <Fragment slot="content">Turn "hard to explain" into a clip anyone can follow.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    tagline="AI features"
    title="AI that finishes the screenshot for you"
    items={[
      {
        title: 'Cut out a subject',
        description:
          'Transparent PNGs of people and products in seconds — no Photoshop, no upload, no waiting on a server.',
      },
      {
        title: 'Erase what shouldn’t be there',
        description:
          'Objects, watermarks, blemishes: paint over them and the AI fills the gap naturally, offline.',
      },
      {
        title: 'Read the text inside',
        description: 'OCR runs on your device and hands back editable, copyable text in one click.',
      },
      {
        title: 'Swap in better models',
        description: 'Point the cutout and eraser at a newer model whenever one lands — no app update required.',
      },
    ]}
    image={{
      src: '~/assets/images/ai-demo.png',
      alt: 'AI background removal and OCR demo',
    }}
  >
    <Fragment slot="content"
      >AI cutout, eraser, and OCR all run locally — intelligence without sacrificing privacy.</Fragment
    >

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="From screen to shared in three steps."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Press the shortcut</span>',
        description: 'Summon Shotera anywhere and hover — the window or element you want is already detected.',
        icon: 'tabler:keyboard',
      },
      {
        title: 'Step 2: <span class="font-medium">Annotate, extract, or edit</span>',
        description: 'Mark up the important parts, run OCR, cut out a subject, translate — in the same window.',
        icon: 'tabler:wand',
      },
      {
        title: 'Step 3: <span class="font-medium">Copy, save, or pin</span>',
        description: 'Send it to the clipboard, save it locally, or pin it on top for quick reference.',
        icon: 'tabler:share',
      },
      {
        title: 'Done!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: '~/assets/images/workflow.png',
      alt: 'Shotera workflow',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="The small touches you'll miss elsewhere"
    subtitle="It's the details that make Shotera hard to put down."
    tagline="More features"
    items={[
      {
        title: 'Emoji stickers',
        description: 'Drop an emoji sticker in one click and make a dry screenshot say more.',
        icon: 'tabler:mood-happy',
      },
      {
        title: 'Magnifier',
        description: 'Zoom in on the one detail that matters, so nobody misses it.',
        icon: 'tabler:zoom-in',
      },
      {
        title: 'Step numbers',
        description: 'Number your steps in order — made for tutorials and how-to guides.',
        icon: 'tabler:list-numbers',
      },
      {
        title: 'Pin to screen',
        description: 'Float a reference image on top and work beside it, no window juggling.',
        icon: 'tabler:pin',
      },
      {
        title: 'Custom shortcuts',
        description: 'Bind the actions you use most to keys that fit your hands.',
        icon: 'tabler:keyboard',
      },
      {
        title: 'History',
        description: 'Every capture and recording is kept automatically, so a slip never loses your work.',
        icon: 'tabler:history',
      },
      {
        title: 'Multi-monitor support',
        description: 'Accurate on every screen, including mixed high-DPI setups.',
        icon: 'tabler:devices',
      },
      {
        title: 'Local-first & private',
        description: 'OCR and the AI tools run on your device. Nothing is uploaded — your screenshots are yours.',
        icon: 'tabler:lock',
      },
      {
        title: 'Light on resources',
        description: 'Opens in a blink and idles quietly, ready without slowing you down.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Dark mode',
        description: 'Follows your system theme, day or night.',
        icon: 'tabler:moon',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- HighlightedPosts Widget ******* -->

  <!-- 临时屏蔽博客推广区块
  <BlogLatestPosts
    title="Tips & updates"
    information={`On the blog we share Shotera tips, shortcut tricks, release notes, and efficient workflows
                        to help you get more out of it.
                `}
  />
  -->

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Languages', amount: '15' },
      { title: 'Rating', amount: '4.9 / 5' },
      { title: 'Offline AI', amount: '100%' },
      { title: 'Launch time', amount: '<0.1s' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction id="download">
    <DownloadButtons
      slot="actions"
      language="en-us"
      downloadLabel="Download free"
      moreVersionsLabel="More versions"
      storeAriaLabel="Get Shotera from Microsoft Store"
      downloadAriaLabel="Download the latest Shotera installer for Windows"
      moreVersionsAriaLabel="More download options"
      recommendLabel="Recommended"
      msiLabel="MSI installer"
      portableLabel="Portable (.7z)"
      allVersionsLabel="All versions on GitHub"
      footnoteLabel="Prefer something lighter? See Shotera Lite (~17 MB) →"
      footnoteHref="/versions/"
    />

    <Fragment slot="title"
      >Make your everyday<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">
        screenshots faster</span
      ></Fragment
    >

    <Fragment slot="subtitle">
      Download free, install in seconds.<br class="hidden md:inline" />Core features are free forever.
    </Fragment>
  </CallToAction>
</Layout>
