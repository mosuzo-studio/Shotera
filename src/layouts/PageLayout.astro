---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';
import Announcement from '~/components/widgets/Announcement.astro';

import { getHeaderData, getFooterData } from '~/navigation';

import { defaultLang, type Lang } from '~/i18n/utils';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  lang?: Lang;
}

const { metadata, lang: explicitLang } = Astro.props;

const lang = explicitLang ?? ((Astro.currentLocale ?? defaultLang) as Lang);
const headerData = getHeaderData(lang);
const footerData = getFooterData(lang);
---

<Layout metadata={metadata} language={lang}>
  <slot name="announcement">
    <Announcement lang={lang} />
  </slot>
  <slot name="header">
    <Header {...headerData} lang={lang} isSticky showRssFeed showToggleTheme />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
